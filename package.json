{
  "name": "dsh-auto-continue-on-error",
  "version": "1.3.0",
  "scripts": { "test": "node --test *.test.js" },
  "description": "报错后自动继续目标：任意模型错误自动恢复并支持中文设置。",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/kogekiplay/dsh-auto-continue-on-error.git" },
  "homepage": "https://github.com/kogekiplay/dsh-auto-continue-on-error#readme",
  "bugs": "https://github.com/kogekiplay/dsh-auto-continue-on-error/issues",
  "engines": { "node": ">=24.9.0" },
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "exports": {
    ".": "./host-1.3.0.js",
    "./client": "./client-1.3.0.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host-1.3.0.js", "index.js", "settings-control.js", "client-1.3.0.js",
    "*.test.js", "cordis.patch.yml", "locale/*.json", "icon.svg",
    "README.md", "README.zh.md", "LICENSE", "package.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web", "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-settings-general"]
    }
  },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5" }
}
